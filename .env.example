# Database
DATABASE_URL="postgresql://workshop:workshop@localhost:5432/mecanica_billing_db"

# Server
PORT=3000
HOST="0.0.0.0"
NODE_ENV="development"
# Level of the JSON logs written outside development (default: info)
LOG_LEVEL="info"

# New Relic APM (observability). Leave NEW_RELIC_LICENSE_KEY empty to run with
# the agent disabled (no crash, just a startup log line) - only needed against
# a real New Relic account (staging/production).
NEW_RELIC_APP_NAME="mecanica-billing-castor-garage"
NEW_RELIC_LICENSE_KEY=""
NEW_RELIC_AI_MONITORING_ENABLED=true
NEW_RELIC_CUSTOM_INSIGHTS_EVENTS_MAX_SAMPLES_STORED=100k
NEW_RELIC_SPAN_EVENTS_MAX_SAMPLES_STORED=10k

# --- A partir daqui: variaveis previstas para a Fase 2 do backlog (ainda nao
# consumidas pelo codigo deste scaffold inicial - ver ADR 0006/RFC 0004 em
# mecanica-pos-SOAT/docs) ---

# Mercado Pago (Checkout) - obtido no painel de desenvolvedores do Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""

# URL pública deste serviço (usada como notification_url na preferência do MP)
# Localmente: use ngrok (ex: https://abc123.ngrok.io)
WEBHOOK_BASE_URL=""

# URL base do frontend para back_urls do Checkout Pro
FRONTEND_URL=""

# MongoDB para PaymentAttempt (payloads brutos de webhook)
NOSQL_CONNECTION_STRING="mongodb://localhost:27017"
MONGO_DB_NAME="mecanica_billing"

# Amazon SQS (filas provisionadas em mecanica-k8s-infra-SOAT)
SQS_BILLING_COMMANDS_QUEUE_URL=""
SQS_OS_EVENTS_QUEUE_URL=""
AWS_REGION="us-east-1"
