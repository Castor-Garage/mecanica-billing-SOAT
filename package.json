{
  "name": "mecanica-billing-api",
  "version": "0.1.0",
  "description": "Billing Service (orcamento, aprovacao e pagamento) - Tech Challenge Fase 4 (SOAT)",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "npm run test:unit",
    "test:all": "npm run test:unit && npm run test:integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "mp:create-test-users": "tsx scripts/create-mp-test-users.ts"
  },
  "dependencies": {
    "@fastify/swagger": "^9.9.5",
    "@fastify/swagger-ui": "^5.2.6",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/pg": "^8.20.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.8.5",
    "fastify-type-provider-zod": "^4.0.2",
    "mercadopago": "^2.0.15",
    "mongodb": "^7.9.0",
    "newrelic": "^14.4.0",
    "pg": "^8.20.0",
    "pino-pretty": "^13.1.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@vitest/coverage-v8": "^4.1.5",
    "prisma": "^7.8.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.5"
  },
  "allowScripts": {
    "mongodb@7.9.0": true,
    "protobufjs@7.6.6": true,
    "prisma@7.10.1": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "@newrelic/fn-inspect@5.1.0": true,
    "@prisma/engines@7.10.1": true
  }
}
